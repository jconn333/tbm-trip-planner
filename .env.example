# Copy this file to .env or .env.local and fill in values for your environment.
# Do not commit real secrets.

# App/server
PORT=5050
LOG_LEVEL=INFO
APP_ENV=development
FLASK_DEBUG=false
FLASK_SECRET_KEY=replace-with-long-random-string
TBM_DB_PATH=/absolute/path/to/tbm.sqlite3
TBM_HOME_TZ=America/New_York
TBM_DEFAULT_PARKED_ICAO=
TBM_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
TBM_BOOTSTRAP_ADMIN_NAME=TBM Admin
TBM_BOOTSTRAP_ADMIN_PASSWORD=change-me-now
TBM_RATE_LIMIT_WINDOW_SEC=60
TBM_RATE_LIMIT_LOGIN_PER_WINDOW=20
TBM_RATE_LIMIT_ADMIN_WRITES_PER_WINDOW=60
TBM_ENABLE_RATE_LIMIT=false

# Performance/cache tuning
WINDS_REGION=us
WINDS_LEVEL=low
WINDS_LAYOUT=off
WINDS_CACHE_TTL_SEC=900
WINDS_CACHE_MAX_KEYS=32

GEOCODE_TIMEOUT_SEC=8
GEOCODE_CACHE_TTL_SEC=3600
GEOCODE_CACHE_MAX_KEYS=128
GEOCODE_USER_AGENT=tbm-trip-planner/1.0 (nearest-airports)
GEOCODE_SUGGEST_MIN_CHARS=3
GEOCODE_SUGGEST_LIMIT=6
GEOCODE_COUNTRY_CODES=us

AIRPORT_META_TIMEOUT_SEC=8
AIRPORT_META_CACHE_TTL_SEC=21600
AIRPORT_META_CACHE_MAX_KEYS=512
LIVE_TRACKING_TAIL=N656W

# Trip assumptions
TBM_TAS_TYPICAL=290
TBM_TAS_CONSERVATIVE=280
TBM_ROUTING_TYPICAL=1.03
TBM_ROUTING_CONSERVATIVE=1.10
TBM_OVERHEAD_TYPICAL_MIN=15
TBM_OVERHEAD_CONSERVATIVE_MIN=20
TBM_MGMT_FEE_PER_HR=100
TBM_MAINT_RESERVE_PER_HR=250
TBM_ENGINE_RESERVE_PER_HR=215
TBM_FUEL_PRICE_PER_GAL=5.50
TBM_FUEL_BURN_GPH=60
